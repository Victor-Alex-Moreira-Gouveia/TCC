# Copie para .env.local ao executar Flask fora do Docker.
# Para WampServer/MySQL local, normalmente use host 127.0.0.1 e porta 3306.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=MausTratosDB

# O cache é opcional no modo local; o banco segue como requisito.
CACHE_ENABLED=false
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

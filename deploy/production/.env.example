# Exemplo exclusivo de produção. Copie para .env na raiz e preencha localmente.
# Os campos secretos ficam vazios de propósito; defina valores exclusivos antes de iniciar.
# Nunca versione o .env preenchido.
DATABASE_NAME=MausTratosDB

# Senha do usuário tcc_app usada pelo aplicativo e pelo MariaDB.
DATABASE_PASSWORD=
# Senha da conta root do MariaDB, usada apenas na inicialização/healthcheck.
MARIADB_ROOT_PASSWORD=
# Senha do usuário de manutenção tcc_db_admin do phpMyAdmin.
TCC_DB_ADMIN_PASSWORD=

# Conta administrativa própria do site.
ROOT_USERNAME=
ROOT_EMAIL=
ROOT_PASSWORD=
# Chave de assinatura das sessões Flask.
FLASK_SECRET_KEY=
